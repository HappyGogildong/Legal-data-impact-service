# 신뢰 출처 API 키 (각 포털에서 발급)
# ※ 법제처(MOLEG)가 입법예고·국가법령정보를 둘 다 운영 → '내용' 기준으로 구분
ASSEMBLY_API_KEY=        # 열린국회 open.assembly.go.kr — 의원발의 법안 (ServiceKey)
MOLEG_OC=                # 법제처 정부입법예고 lawmaking.go.kr — 정부제출 법안 (OC=회원 이메일 아이디)
LAW_OC=                  # 국가법령정보 open.law.go.kr — 현행 법령 (OC=회원 이메일 아이디)

# 임베딩·추론 (foundation API)
OPENAI_API_KEY=          # 임베딩(text-embedding-3-small) 등
UPSTAGE_API_KEY=         # 임베딩 벤치 후보(solar-embedding)
ANTHROPIC_API_KEY=       # 영향 추론(Claude Opus 4.8)

# 소셜 로그인 OAuth2 (D60 — 각 provider 개발자 콘솔에서 앱 등록 후 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=         # kakao 는 REST API 키
KAKAO_CLIENT_SECRET=     # kakao: 보안 설정에서 client_secret 발급(사용함=ON)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:3000  # 비워 두지 말 것 — 없으면 기본값
# PRIVACY_POLICY_VERSION=draft-2026-09  # 비워 두지 말 것 — 없으면 기본값, 빈 값이면 부팅 실패

# 저장소
DATABASE_URL=postgresql://lia:lia@localhost:5432/lia
