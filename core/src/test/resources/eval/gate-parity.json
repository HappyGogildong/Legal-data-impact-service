{
  "lowerIsBetter": ["discovery.irrelevant", "nomatch.candidate_rate", "refusal.over"],
  "cases": [
    {"name": "허용 안 하락은 통과", "tolerance": 0.02,
     "baseline": {"discovery.hit@3": {"value": 0.90, "n": 100}},
     "report": {"discovery.hit@3": {"value": 0.89, "n": 100}},
     "expectedFailures": []},
    {"name": "높을수록 지표가 허용 넘게 하락하면 회귀", "tolerance": 0.02,
     "baseline": {"discovery.hit@3": {"value": 0.90, "n": 100}},
     "report": {"discovery.hit@3": {"value": 0.85, "n": 100}},
     "expectedFailures": ["discovery.hit@3"]},
    {"name": "낮을수록 지표가 허용 넘게 오르면 회귀", "tolerance": 0.02,
     "baseline": {"refusal.over": {"value": 0.0, "n": 100}},
     "report": {"refusal.over": {"value": 0.05, "n": 100}},
     "expectedFailures": ["refusal.over"]},
    {"name": "낮을수록 지표가 내려가면 개선", "tolerance": 0.02,
     "baseline": {"nomatch.candidate_rate": {"value": 0.6, "n": 5}},
     "report": {"nomatch.candidate_rate": {"value": 0.2, "n": 5}},
     "expectedFailures": []},
    {"name": "정확히 허용만큼은 통과", "tolerance": 0.02,
     "baseline": {"discovery.hit@3": {"value": 0.90, "n": 100}},
     "report": {"discovery.hit@3": {"value": 0.88, "n": 100}},
     "expectedFailures": []},
    {"name": "작은 분모는 1/n 까지 허용", "tolerance": 0.02,
     "baseline": {"article.match": {"value": 1.0, "n": 5}},
     "report": {"article.match": {"value": 0.8, "n": 5}},
     "expectedFailures": []},
    {"name": "허용 오차의 1/n 은 지금 보고서 분모", "tolerance": 0.02,
     "baseline": {"discovery.hit@3": {"value": 1.0, "n": 100}},
     "report": {"discovery.hit@3": {"value": 0.85, "n": 5}},
     "expectedFailures": []},
    {"name": "작은 분모도 1/n 을 넘으면 회귀", "tolerance": 0.02,
     "baseline": {"article.match": {"value": 1.0, "n": 5}},
     "report": {"article.match": {"value": 0.6, "n": 5}},
     "expectedFailures": ["article.match"]},
    {"name": "기준선에 있던 지표가 사라지면 회귀", "tolerance": 0.02,
     "baseline": {"refusal.recall": {"value": 1.0, "n": 6}},
     "report": {},
     "expectedFailures": ["refusal.recall"]},
    {"name": "기준선에 없는 새 지표는 비교하지 않음", "tolerance": 0.02,
     "baseline": {},
     "report": {"intent.macro_f1": {"value": 0.1, "n": 14}},
     "expectedFailures": []},
    {"name": "의도 차원 지표는 높을수록 좋음", "tolerance": 0.02,
     "baseline": {"intent.DIFF.f1": {"value": 0.8, "n": 5}},
     "report": {"intent.DIFF.f1": {"value": 0.5, "n": 5}},
     "expectedFailures": ["intent.DIFF.f1"]},
    {"name": "여러 지표 중 넘은 것만 회귀", "tolerance": 0.02,
     "baseline": {"discovery.hit@3": {"value": 0.9, "n": 14}, "discovery.irrelevant": {"value": 0.1, "n": 20},
                  "law.resolution": {"value": 1.0, "n": 14}},
     "report": {"discovery.hit@3": {"value": 0.5, "n": 14}, "discovery.irrelevant": {"value": 0.5, "n": 20},
                "law.resolution": {"value": 0.95, "n": 14}},
     "expectedFailures": ["discovery.hit@3", "discovery.irrelevant"]}
  ]
}
