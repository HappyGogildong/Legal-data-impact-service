      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "description": "예외로 끝난 요청(입력 오류 포함). 원인은 로그·트레이스에서 본다.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS errors FROM query_events WHERE $__timeFilter(occurred_at) AND status = 'ERROR'"
