    {
      "id": 14,
      "title": "개인화 하루 한도 도달",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 19
      },
      "description": "첫 분석·재생성에서 개인화 하루 한도(lia.personalization.daily-limit)에 걸린 요청.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS requests FROM query_events WHERE $__timeFilter(occurred_at) AND unmet::text LIKE '%\"DAILY_LIMIT\"%'"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 15,
      "title": "상황 반영 재생성 결과",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "description": "SITUATION_EXPIRED = 세션의 상황 질문이 만료됨(다시 받아야 함).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT status, unmet ->> 'ACTION' AS reason, count(*) AS requests FROM query_events\nWHERE $__timeFilter(occurred_at) AND kind = 'ACTION_REVISION' GROUP BY status, reason ORDER BY requests DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "조문 지목 비율",
      "type": "stat",
      "datasource": {
