{
  "uid": "lia-requests",
  "title": "LIA · Requests",
  "description": "질의 이벤트(query_events)로 본 요청 결과 — 거부·미해소·못 채운 사유·한도 도달(D83). 원문 없음.",
  "tags": [
    "lia",
    "eval",
    "requests"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "분석 요청",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "description": "첫 분석 요청 수(익명 상한에 막힌 것·오류 포함). 재생성은 따로 센다.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS requests FROM query_events WHERE $__timeFilter(occurred_at) AND kind = 'ANALYZE'"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "답한 비율",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "description": "차원을 1개 이상 채웠거나 발견 후보를 1건 이상 낸 요청의 비율.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT (count(*) FILTER (WHERE status = 'ANSWERED'))::numeric / NULLIF(count(*), 0) AS ratio FROM query_events WHERE $__timeFilter(occurred_at) AND kind = 'ANALYZE'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "로그인 비율",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
