          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT (count(*) FILTER (WHERE signed_in))::numeric / NULLIF(count(*), 0) AS ratio FROM query_events WHERE $__timeFilter(occurred_at) AND kind = 'ANALYZE'"
