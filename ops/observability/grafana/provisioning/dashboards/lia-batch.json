{
  "uid": "lia-batch",
  "title": "LIA · Batch",
  "tags": [
    "lia",
    "batch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "마지막 실행",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT command, outcome, started_at, finished_at, finished_at - started_at AS duration FROM ingest_runs ORDER BY started_at DESC LIMIT 1"
        }
      ]
    },
    {
      "id": 2,
      "title": "마지막 성공 이후 경과(시간)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(finished_at)) / 3600 AS hours FROM ingest_runs WHERE outcome = 'SUCCESS' AND command IN ('run', 'run --full')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 시간",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 26
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "최근 실행 20건",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT started_at, command, outcome, list_complete, counts->>'done' AS done, counts->>'failed' AS failed, counts->>'dead' AS dead, counts->>'deferred.INDEX' AS deferred_index, counts->>'malformedRows' AS malformed, counts->>'duplicateKeys' AS duplicate_keys, counts->>'notified' AS notified FROM ingest_runs ORDER BY started_at DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 4,
      "title": "작업 상태",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'READY') AS \"READY\", count(*) FILTER (WHERE status = 'RUNNING') AS \"RUNNING\", count(*) FILTER (WHERE status = 'DEAD') AS \"DEAD\" FROM ingest_tasks"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "DEAD"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "색인 지연",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS ready_index, EXTRACT(EPOCH FROM now() - min(created_at)) / 3600 AS oldest_hours FROM ingest_tasks WHERE kind = 'INDEX' AND status = 'READY'"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "일별 추이",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', started_at) AS time, outcome, count(*) AS runs FROM ingest_runs WHERE $__timeFilter(started_at) AND outcome IS NOT NULL GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "DEAD 목록",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lia-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT kind, law_id, effective_date, attempts, last_error, updated_at FROM ingest_tasks WHERE status = 'DEAD' ORDER BY updated_at DESC"
        }
      ]
    }
  ]
}
