# 운영 비밀 아닌 설정(D63·D78). 비밀값은 SSM Parameter Store /lia/prod/ — ops/deploy/lia 가 실행 때 환경변수로 넘긴다.
# 주소(cloud-infra §1.1) — Elastic IP·Vercel 프로젝트를 만든 뒤 채운다.
LIA_DOMAIN=api.15-165-252-201.sslip.io
FRONTEND_URL=https://legal-data-impact-service.vercel.app
OAUTH2_REDIRECT_BASE_URL=https://legal-data-impact-service.vercel.app
# RDS 엔드포인트(런북 5단계)
LIA_DB_HOST=lia-db.ctu4qekm26da.ap-northeast-2.rds.amazonaws.com
LIA_DB_SSLMODE=require
# 앱
SPRINGDOC_API_DOCS_ENABLED=false
LIA_ANALYSIS_ANONYMOUS_DAILY_LIMIT=1000
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
JAVA_TOOL_OPTIONS=-Xmx512m
# 배치 — 요약·변경점(유료 Opus)은 꺼 둔다. 켜기 전 `ops/deploy/lia ingest summarize --dry-run` 으로 규모 확인(D67·D78)
LIA_BATCH_SUMMARY_ENABLED=false
LIA_BATCH_INDEX_ENABLED=true
