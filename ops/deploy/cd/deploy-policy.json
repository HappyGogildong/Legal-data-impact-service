{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunDeployDocumentOnProdInstanceOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:<account-id>:document/LIA-Deploy",
        "arn:aws:ec2:ap-northeast-2:<account-id>:instance/<instance-id>"
      ]
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
